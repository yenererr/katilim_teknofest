{
  "name": "katilim-finans-analiz-ajani",
  "private": true,
  "version": "0.1.0",
  "description": "Katılım bankacılığı kampanya ve ürün metinlerinden finansal bilgi çıkaran, normalize eden ve ürünleri karşılaştıran NLP çözümü.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run src/server/services/qdrant/__tests__/qdrant.integration.test.ts",
    "eval:campaign-reference": "tsx scripts/evaluate-campaign-reference-dataset.ts",
    "scrape:campaigns": "tsx scripts/scrape-campaigns.ts",
    "import:campaigns": "tsx scripts/import-campaigns-to-db.ts",
    "import:verified-research": "tsx scripts/import-verified-research-to-db.ts",
    "speech:start": "speech-service\\venv\\Scripts\\python speech-service\\run_speech_service.py",
    "eval:gold": "tsx scripts/evaluate-gold.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
