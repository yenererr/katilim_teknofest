# EVREN_API_KEY: SSB EVREN API anahtarı. Gerçek anahtarı kaynak koda yazmayın.
# Tanımlı değilse sunucu kural tabanlı (regex) çıkarıma düşer.
EVREN_API_KEY="sk-evren-teamNN-ANAHTARINIZ"

# EVREN_MODEL: Kullanılacak model aliası. Varsayılan: llm-fast
EVREN_MODEL="llm-fast"

# EVREN_BASE_URL: OpenAI uyumlu EVREN endpoint'i.
EVREN_BASE_URL="https://evren-llmapi.ssyz.org.tr/v1"

# APP_URL: Uygulamanın host edildiği URL.
APP_URL="MY_APP_URL"
