# NVIDIA_API_KEY: NVIDIA NIM (build.nvidia.com) API anahtarı, "nvapi-" ile başlar.
# Tanımlı değilse sunucu kural tabanlı (regex) çıkarıma düşer.
NVIDIA_API_KEY="nvapi-XXXXXXXXXXXXXXXX"

# NVIDIA_MODEL: Kullanılacak model. Varsayılan: meta/llama-3.3-70b-instruct
# Alternatifler: nvidia/llama-3.3-nemotron-super-49b-v1.5, qwen/qwen2.5-72b-instruct
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# NVIDIA_BASE_URL: OpenAI uyumlu endpoint. Self-hosted NIM için değiştirin.
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"

# APP_URL: Uygulamanın host edildiği URL.
APP_URL="MY_APP_URL"
